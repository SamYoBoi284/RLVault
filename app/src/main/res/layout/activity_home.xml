<?xml version="1.0" encoding="utf-8"?>
<!--
    Bare Home screen, Milestone 1 "jump ahead" scope: static/placeholder content only.
    Real data wiring (last session summary, pending review count, latest achievement) is
    intentionally deferred until the achievement evaluator + more repository-consuming logic
    exists — see SESSION_HANDOFF.md Option 3.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_title"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/pendingReviewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/home_pending_review_label"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/pendingReviewValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_placeholder_value"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/pendingReviewLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lastSessionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/home_last_session_label"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/pendingReviewValue"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lastSessionValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_placeholder_value"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/lastSessionLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/latestAchievementLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/home_latest_achievement_label"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/lastSessionValue"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/latestAchievementValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_placeholder_value"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/latestAchievementLabel"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/importClipButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/home_import_clip_button"
        app:layout_constraintTop_toBottomOf="@id/latestAchievementValue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/logSessionButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_log_session_button"
        app:layout_constraintTop_toBottomOf="@id/importClipButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/devModeButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_dev_mode_button"
        app:layout_constraintTop_toBottomOf="@id/logSessionButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/reviewClipsButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/home_review_clips_button"
        app:layout_constraintTop_toBottomOf="@id/devModeButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
