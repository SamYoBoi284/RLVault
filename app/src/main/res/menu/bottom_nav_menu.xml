<?xml version="1.0" encoding="utf-8"?>
<!--
    Order here defines left-to-right order in the BottomNavigationView, per spec:
    Sessions, Clips, Home, Progress, Settings.

    Icons are stock @android:drawable placeholders (no custom vector assets exist in this
    project yet) — swap for real iconography whenever that art is ready, item ids don't need
    to change.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/nav_sessions"
        android:icon="@android:drawable/ic_menu_recent_history"
        android:title="@string/nav_sessions" />

    <item
        android:id="@+id/nav_clips"
        android:icon="@android:drawable/ic_menu_slideshow"
        android:title="@string/nav_clips" />

    <item
        android:id="@+id/nav_home"
        android:icon="@android:drawable/ic_menu_myplaces"
        android:title="@string/nav_home" />

    <item
        android:id="@+id/nav_progress"
        android:icon="@android:drawable/ic_menu_sort_by_size"
        android:title="@string/nav_progress" />

    <item
        android:id="@+id/nav_settings"
        android:icon="@android:drawable/ic_menu_preferences"
        android:title="@string/nav_settings" />

</menu>
