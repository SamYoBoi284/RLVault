<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission — RL Vault is fully offline per spec. -->

    <application
        android:name=".RLVaultApp"
        android:allowBackup="false"
        android:label="RL Vault"
        android:theme="@style/Theme.RLVault"
        tools:targetApi="34"
        xmlns:tools="http://schemas.android.com/tools">

        <!-- android:icon intentionally omitted — no launcher icon asset exists yet (visual/UI
             work is deferred past Milestone 1). Add @mipmap/ic_launcher back once real icon
             assets are created. -->
        <!-- Bare Home screen (static placeholder content) — jumped ahead per SESSION_HANDOFF.md
             Option 3. Real data wiring still Milestone 2+. -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.clip.ImportClipActivity" android:exported="false" />
        <activity android:name=".ui.session.LogSessionActivity" android:exported="false" />
        <activity android:name=".ui.dev.DeveloperModeActivity" android:exported="false" />

    </application>

</manifest>