<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No INTERNET permission — RL Vault is fully offline per spec. -->

    <application
        android:name=".RLVaultApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="RL Vault"
        android:theme="@style/Theme.RLVault"
        tools:targetApi="34"
        xmlns:tools="http://schemas.android.com/tools">

        <!-- Launcher Activity: hosts the BottomNavigationView + the five nav destinations
             (Sessions / Clips / Home / Progress / Settings) as Fragments. Replaces the old
             bare HomeActivity — see ui.main.MainActivity. -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.clip.ImportClipActivity" android:exported="false" />
        <activity android:name=".ui.session.LogSessionActivity" android:exported="false" />
        <activity android:name=".ui.dev.DeveloperModeActivity" android:exported="false" />
        <activity android:name=".ui.review.ClipDetailActivity" android:exported="false" />
        <activity android:name=".ui.player.PlayerActivity" android:exported="false" />

    </application>

</manifest>